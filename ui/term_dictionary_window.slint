// Standalone editor for the professional-vocabulary term dictionary (F02,
// see `src/term_dictionary.rs`): a plain list of "wrong -> correct" rows the
// user maintains by hand. Independent window, own lifecycle -- opened from
// the main window (wiring done by the integrator, not this file) and closed
// again via "取消"/"保存", never interacting with `Overlay` or `MainWindow`.
//
// Styled to match `ui/main_window.slint`: same `Theme` import, same
// Theme.surface header bar with a bottom Theme.border hairline.
//
// Design reference (behavior, not code): `src-reference/OpenSuperWhisper.App/TermDictionaryWindow.xaml`.

import { ListView, LineEdit, Button } from "std-widgets.slint";
import { Theme } from "theme.slint";

// One editable row. Plain data, no identity beyond list position -- `Rust`
// side callbacks are index-addressed (see `edit-wrong`/`edit-correct`/
// `delete-row` below), matching how `main.rs` already index-addresses
// `history_model` rows.
export struct TermRow {
    wrong: string,
    correct: string,
}

export component TermDictionaryWindow inherits Window {
    title: "专业词典";
    width: 460px;
    height: 440px;
    background: Theme.background;

    in property <[TermRow]> rows: [];

    callback add-row();
    callback delete-row(int);
    callback edit-wrong(int, string);
    callback edit-correct(int, string);
    callback save();
    callback cancel();

    // Two-column labels above the list. Widths mirror the per-row
    // HorizontalLayout below (two stretchy LineEdits + a fixed-width delete
    // column) so the labels roughly line up with their fields.
    Text {
        x: 16px;
        y: 8px;
        width: (parent.width - 32px - 28px - 16px) / 2;
        height: 18px;
        text: "错误词";
        font-size: 11px;
        color: Theme.muted;
    }

    Text {
        x: 16px + (parent.width - 32px - 28px - 16px) / 2 + 8px;
        y: 8px;
        width: (parent.width - 32px - 28px - 16px) / 2;
        height: 18px;
        text: "正确词";
        font-size: 11px;
        color: Theme.muted;
    }

    ListView {
        x: 8px;
        y: 32px;
        width: parent.width - 16px;
        height: 254px;

        for row[i] in rows: Rectangle {
            height: 48px;
            width: parent.width;

            HorizontalLayout {
                x: 8px;
                y: 4px;
                width: parent.width - 16px;
                height: parent.height - 8px;
                spacing: 8px;

                LineEdit {
                    text: row.wrong;
                    edited(t) => { edit-wrong(i, t); }
                }

                LineEdit {
                    text: row.correct;
                    edited(t) => { edit-correct(i, t); }
                }

                Rectangle {
                    width: 28px;
                    height: parent.height;
                    border-radius: 4px;

                    Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: "×";
                        font-size: 16px;
                        color: Theme.muted;
                    }

                    TouchArea {
                        clicked => { delete-row(i); }
                    }
                }
            }
        }
    }

    Button {
        x: 16px;
        y: 296px;
        width: parent.width - 32px;
        height: 36px;
        text: "添加一行";
        clicked => { add-row(); }
    }

    // Footer: 取消 / 保存, right-aligned. 保存 uses `primary: true` rather
    // than a hardcoded background color -- std-widgets' `Button` (see
    // `i-slint-compiler` widgets/fluent/button.slint) intentionally exposes
    // no `background`/`color` in-properties to override (setting one would
    // be a compile error, "unknown property"), so `primary` is the only
    // widget-supported way to render an emphasized accent-filled button;
    // it visually matches this app's Theme.accent / Theme.accent-foreground
    // pairing used everywhere else (e.g. the accent dot in main_window.slint)
    // even though the exact pixel color comes from the active Fluent style
    // rather than a direct `Theme.accent` reference.
    Rectangle {
        x: 0px;
        y: parent.height - 52px;
        width: parent.width;
        height: 52px;
        background: Theme.surface;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }

        Button {
            x: parent.width - 200px;
            y: 10px;
            width: 88px;
            height: 32px;
            text: "取消";
            clicked => { cancel(); }
        }

        Button {
            x: parent.width - 104px;
            y: 10px;
            width: 88px;
            height: 32px;
            text: "保存";
            primary: true;
            clicked => { save(); }
        }
    }
}
