// Main application window: shown/hidden via the tray icon (left-click) and
// the global Ctrl+Alt+H show/hide hotkey (see `src/show_hide_hotkey.rs` and
// `src/main.rs`) -- entirely independent of the always-on-top `Overlay`
// status window (`main.rs`'s inline `slint::slint!{}` macro), which keeps
// showing the current phase during an actual dictation regardless of whether
// this window is open.
//
// Design reference (behavior, not code): `src-reference/OpenSuperWhisper.App/MainWindow.xaml`.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// One entry in the real (see `src/history.rs`) recent-dictation list.
export struct HistoryEntry {
    time: string,
    text: string,
}

export component MainWindow inherits Window {
    title: "Aevocis";
    icon: @image-url("../assets/app.png");
    width: 380px;
    height: 560px;
    background: Theme.background;

    // Driven from Rust: reuses the same phase wording as the Overlay
    // ("就绪" / "正在听" / "正在识别" / ...), see `main.rs::phase_label`.
    in property <string> status-text: "就绪";
    in property <[HistoryEntry]> history: [];
    // Emitted when the user clicks the header's gear icon / history footer's
    // "清空" button -- `main.rs` opens the settings window / clears history.
    callback open-settings();
    callback clear-history();

    // Header: brand + live status dot + settings gear, mirrors
    // MainWindow.xaml's top border.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 54px;
        background: Theme.surface;

        Text {
            x: 16px;
            y: 0px;
            height: parent.height;
            vertical-alignment: center;
            text: "Aevocis";
            font-size: 17px;
            font-weight: 600;
            color: Theme.ink;
        }

        settings-gear := Text {
            x: parent.width - 34px;
            y: 0px;
            width: 24px;
            height: parent.height;
            vertical-alignment: center;
            horizontal-alignment: center;
            text: "⚙";
            font-size: 16px;
            color: Theme.muted;

            TouchArea {
                clicked => { open-settings(); }
            }
        }

        Rectangle {
            x: parent.width - 150px;
            y: (parent.height - 8px) / 2;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.accent;
        }

        Text {
            x: parent.width - 134px;
            y: 0px;
            width: 90px;
            height: parent.height;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: status-text;
            font-size: 12px;
            color: Theme.muted;
        }

        Rectangle {
            x: 0px;
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }
    }

    // Hint area: big accent dot + push-to-talk / show-hide reminder, mirrors
    // MainWindow.xaml's centered Ellipse + tooltip text.
    Rectangle {
        x: 0px;
        y: 54px;
        width: parent.width;
        height: 128px;
        background: Theme.background;

        Rectangle {
            x: (parent.width - 72px) / 2;
            y: 12px;
            width: 72px;
            height: 72px;
            border-radius: 36px;
            background: Theme.accent;
        }

        Text {
            x: 24px;
            y: 90px;
            width: parent.width - 48px;
            height: 34px;
            text: "按住右 Ctrl 说话，松开自动输入；Ctrl+Alt+H 或单击托盘图标可显示/隐藏";
            font-size: 11px;
            color: Theme.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    // Recent-dictation list, backed by real persisted history
    // (`src/history.rs`) -- no longer placeholder data.
    Text {
        x: 16px;
        y: 190px;
        width: parent.width - 100px;
        height: 24px;
        vertical-alignment: center;
        text: "最近";
        font-size: 11px;
        color: Theme.muted;
    }

    clear-btn := Text {
        x: parent.width - 60px;
        y: 190px;
        width: 44px;
        height: 24px;
        vertical-alignment: center;
        horizontal-alignment: right;
        text: "清空";
        font-size: 11px;
        color: Theme.accent;

        TouchArea {
            clicked => { clear-history(); }
        }
    }

    Rectangle {
        x: 0px;
        y: 214px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    ListView {
        x: 8px;
        y: 218px;
        width: parent.width - 16px;
        height: parent.height - 218px - 8px;

        for entry in history: Rectangle {
            height: 46px;
            width: parent.width;

            Text {
                x: 8px;
                y: 0px;
                width: 44px;
                height: parent.height;
                vertical-alignment: center;
                text: entry.time;
                font-size: 11px;
                color: Theme.muted;
            }

            Text {
                x: 56px;
                y: 0px;
                width: parent.width - 64px;
                height: parent.height;
                vertical-alignment: center;
                text: entry.text;
                font-size: 13px;
                color: Theme.ink;
                wrap: word-wrap;
            }
        }
    }
}
