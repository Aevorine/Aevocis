<Window x:Class="OpenSuperWhisper.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 Aevocis"
        Height="320" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource PaperBackground}"
        Icon="Assets/aevocis-logo.png">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="欢迎使用 Aevocis" FontSize="18" FontFamily="Georgia"
                   Foreground="{DynamicResource PaperInk}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PaperInk}" Margin="0,0,0,10"/>
            <TextBlock x:Name="BodyText" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource PaperMuted}" LineHeight="20"/>
        </StackPanel>

        <StackPanel Grid.Row="2" x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,16">
            <Ellipse Width="8" Height="8" Margin="4,0"/>
            <Ellipse Width="8" Height="8" Margin="4,0"/>
            <Ellipse Width="8" Height="8" Margin="4,0"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Content="上一步" Width="70" Height="26" Click="BackButton_Click"/>
            <Button x:Name="SkipButton" Grid.Column="2" Content="跳过" Width="70" Height="26" Margin="0,0,8,0" Click="SkipButton_Click"/>
            <Button x:Name="NextButton" Grid.Column="3" Content="下一步" Width="110" Height="26" IsDefault="True" Click="NextButton_Click"/>
        </Grid>
    </Grid>
</Window>
