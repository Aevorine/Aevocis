<Window x:Class="OpenSuperWhisper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="超语音" Height="560" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource PaperBackground}"
        FontFamily="Segoe UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PaperHeader}"
                BorderBrush="{StaticResource PaperBorder}" BorderThickness="0,0,0,1" Padding="16,14,16,10">
            <DockPanel>
                <TextBlock Text="超语音" FontSize="16" FontFamily="Georgia" Foreground="{StaticResource PaperInk}" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource PaperAccent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource PaperMuted}" FontSize="12" VerticalAlignment="Center"/>
                    <Button Content="设置..." Margin="12,0,0,0" Padding="8,2" FontSize="11" Click="SettingsButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="24,10,24,16">
            <StackPanel HorizontalAlignment="Center">
                <Ellipse Width="80" Height="80" Fill="{StaticResource PaperAccent}"/>
                <TextBlock Text="按住右 Ctrl 说话，松开自动输入" Foreground="{StaticResource PaperMuted}" FontSize="12" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource PaperSurface}"
                BorderBrush="{StaticResource PaperBorder}" BorderThickness="0,1,0,1" Padding="14,8">
            <DockPanel>
                <TextBlock x:Name="ModelLabel" Text="模型：" FontSize="11" Foreground="{StaticResource PaperMuted}"
                           DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <Button x:Name="ClearHistoryButton" Content="清空历史" HorizontalAlignment="Right"
                        Padding="8,2" FontSize="11" Click="ClearHistoryButton_Click"/>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="最近" FontSize="11" Foreground="{StaticResource PaperMuted}" Margin="16,10,0,4"/>

        <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent" Margin="8,0,8,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="6">
                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" Width="42" Foreground="{StaticResource PaperMuted}" FontSize="11"/>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Width="270" Foreground="{StaticResource PaperInk}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
