<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenSuperWhisper.Core\OpenSuperWhisper.Core.csproj" />
    <ProjectReference Include="..\OpenSuperWhisper.Audio\OpenSuperWhisper.Audio.csproj" />
    <ProjectReference Include="..\OpenSuperWhisper.Recognition\OpenSuperWhisper.Recognition.csproj" />
    <ProjectReference Include="..\OpenSuperWhisper.Hotkeys\OpenSuperWhisper.Hotkeys.csproj" />
    <ProjectReference Include="..\OpenSuperWhisper.TextInjection\OpenSuperWhisper.TextInjection.csproj" />
    <ProjectReference Include="..\OpenSuperWhisper.Storage\OpenSuperWhisper.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Real version for the exe's Properties>Details and Task Manager (previously the SDK
         default 1.0.0 was shown regardless of the Velopack release version, which was confusing
         when troubleshooting which release a machine actually runs). -->
    <Version>1.3.5</Version>
    <!-- Aevocis rebrand: controls the name Windows shows in the notification pill, Explorer's
         Properties > Details tab, and Task Manager - independent of the exe filename/assembly
         name below (OpenSuperWhisper.App.*), which stays as-is since renaming it would also
         require updating every packaging/update source reference (vpk pack's mainExe flag,
         Velopack's GithubSource asset lookup) for no user-visible benefit. -->
    <Product>Aevocis</Product>
    <AssemblyTitle>Aevocis</AssemblyTitle>
    <Company>Aevorine</Company>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <!-- F19 开机秒启动: precompiles to native code at publish time so the process doesn't pay
         JIT cost on first run - only takes effect for a self-contained publish with -r win-x64. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- F26/F27: Velopack needs to run its bootstrap before WPF's own auto-generated Main, so
         App.xaml.cs supplies a custom Main instead of relying on <ApplicationDefinition>'s
         auto-generated one (see the ItemGroup below that demotes App.xaml to a plain Page). -->
    <StartupObject>OpenSuperWhisper.App.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- v1.2.0：捆绑闪电引擎（SenseVoice int8）与中英标点模型；Whisper 的 ggml 模型不再捆绑，
         全部按需下载（ModelCatalog），安装包因此缩小约 460MB。 -->
    <None Include="Models\sensevoice\model.int8.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Models\sensevoice\tokens.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Models\sensevoice\LICENSE-MODEL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Models\punct\model.int8.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('app.ico')" />
    <!-- Aevocis brand mark shown in-window (title bar icon, MainWindow header) - separate from
         app.ico (exe/tray icon) since WPF <Image> needs a raster format, not .ico. -->
    <Resource Include="Assets\aevocis-logo.png" />
  </ItemGroup>

</Project>
