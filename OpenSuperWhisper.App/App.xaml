<Application x:Class="OpenSuperWhisper.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSuperWhisper.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- G27: deep mode follows the system - App.xaml.cs swaps this entry between
                     Theme.Light.xaml/Theme.Dark.xaml at startup and live on
                     SystemEvents.UserPreferenceChanged. Every brush below (and every window's own
                     XAML) references these keys via DynamicResource specifically so the swap
                     re-paints already-open windows instead of only affecting windows created
                     after the switch. -->
                <ResourceDictionary Source="Assets/Theme.Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource PaperBackground}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PaperInk}"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource PaperAccent}"/>
                <Setter Property="Foreground" Value="{DynamicResource PaperAccentForeground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PaperAccent}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
